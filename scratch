    <script src="https://js.stripe.com/v3/"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            
            // --- MODULE 1: Reveal on Scroll ---
            const setupScrollReveal = () => {
                const revealElements = document.querySelectorAll(".reveal");
                const reveal = () => {
                    for (let i = 0; i < revealElements.length; i++) {
                        const windowHeight = window.innerHeight;
                        const elementTop = revealElements[i].getBoundingClientRect().top;
                        const elementVisible = 100;
                        if (elementTop < windowHeight - elementVisible) {
                            revealElements[i].classList.add("active");
                        }
                    }
                };
                window.addEventListener("scroll", reveal);
                reveal();
            };

            // --- MODULE 2: Image Uploader ---
            const setupImageUploader = () => {
                const handleImageUpload = (inputId, imageId) => {
                    const uploadInput = document.getElementById(inputId);
                    const imageElement = document.getElementById(imageId);
                    
                    if (uploadInput && imageElement) {
                        uploadInput.addEventListener('change', (event) => {
                            const file = event.target.files[0];
                            if (file) {
                                const reader = new FileReader();
                                reader.onload = (e) => {
                                    imageElement.src = e.target.result;
                                };
                                reader.readAsDataURL(file);
                            }
                        });
                    }
                };

                handleImageUpload('main-product-upload', 'main-product-image');
                handleImageUpload('testimonial-upload-1', 'testimonial-image-1');
                handleImageUpload('testimonial-upload-2', 'testimonial-image-2');
                handleImageUpload('testimonial-upload-3', 'testimonial-image-3');
            };

            // --- MODULE 3: Stripe Payment ---
            const setupStripe = () => {
                const PUBLISHABLE_KEY = 'pk_test_51ReUmiCsyp9KpY8PRWHRWrZO2aFk72I4soy7FhSgGzwzUUOWUm4IQvQVeIrCgU5hBz8oNt3uhKqxkAamKJNSILb500SncIjArg';
                const PRICE_ID = 'price_1ReW5mCsyp9KpY8PuZ5uXW5c';

                if (!PUBLISHABLE_KEY || !PUBLISHABLE_KEY.startsWith('pk_')) {
                    console.error("Stripe key is not set or invalid.");
                    return;
                }

                const stripe = Stripe(PUBLISHABLE_KEY);
                const checkoutButton = document.getElementById('checkout-button');

                if (checkoutButton) {
                    checkoutButton.addEventListener('click', () => {
                        if (PRICE_ID === 'price_REPLACE_WITH_YOUR_PRICE_ID' || !PRICE_ID) {
                            alert('Store owner: Stripe Price ID is not configured.');
                            return;
                        }
                        
                        stripe.redirectToCheckout({
                            lineItems: [{ price: PRICE_ID, quantity: 1 }],
                            mode: 'payment',
                            successUrl: `${window.location.protocol}//${window.location.host}?payment=success`,
                            cancelUrl: window.location.href,
                        }).then((result) => {
                            if (result.error) {
                                alert(result.error.message);
                            }
                        });
                    });
                }

                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.get('payment') === 'success') {
                    alert('Payment successful! Thank you for your order.');
                    window.history.replaceState(null, null, window.location.pathname);
                }
            };
            
            // Initialize all modules
            setupScrollReveal();
            setupImageUploader();
            setupStripe();
        });
    </script>
