<ul class="glow-bullets">
  {% for item in items %}
    <li>
      <span class="glow-bullets__icon">💡</span>
      <span class="glow-bullets__text">{{ item }}</span>
    </li>
  {% endfor %}
</ul>
{% stylesheet %}
.glow-bullets {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 0.75rem;
}
.glow-bullets li {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  border-radius: 999px;
  background: rgba(0,209,178,0.15);
  color: #F5F7FA;
  font-family: 'Lora', serif;
}
.glow-bullets__icon {
  font-size: 1.2rem;
}
{% endstylesheet %}
