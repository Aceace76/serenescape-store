{% comment %}
  UglyGlow custom hero for Dawn theme
{% endcomment %}
<section class="uglyglow-hero" data-section-id="{{ section.id }}">
  <div class="uglyglow-hero__inner">
    <div class="uglyglow-hero__copy">
      <h1 class="uglyglow-hero__title">{{ section.settings.heading }}</h1>
      <p class="uglyglow-hero__subtitle">{{ section.settings.subheading }}</p>
      <div class="uglyglow-hero__cta">
        <a class="button button--primary" href="{{ section.settings.primary_button_link }}">{{ section.settings.primary_button_label }}</a>
        <a class="button button--ghost" href="{{ section.settings.secondary_button_link }}">{{ section.settings.secondary_button_label }}</a>
      </div>
      <ul class="uglyglow-hero__bullets">
        {% for block in section.blocks %}
          <li>
            <span class="icon">✨</span>
            <span>{{ block.settings.text }}</span>
          </li>
        {% endfor %}
      </ul>
    </div>
    <div class="uglyglow-hero__media">
      {% if section.settings.featured_media != blank %}
        {{ section.settings.featured_media | image_url: width: 1600 | image_tag: class: 'hero-media' }}
      {% else %}
        <div class="hero-media--placeholder">Add a hero image in the theme editor</div>
      {% endif %}
      <div class="hero-badge">
        <span class="hero-badge__label">Glow Guarantee</span>
        <span class="hero-badge__detail">Free light strand replacement for life</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UglyGlow Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Glow Like You Mean It" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Limited-run ugly Christmas sweaters that light up your living room and your likes." },
    { "type": "url", "id": "primary_button_link", "label": "Primary CTA link", "default": "shopify://collections/all" },
    { "type": "text", "id": "primary_button_label", "label": "Primary CTA label", "default": "Shop the Glow" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary CTA link", "default": "shopify://pages/find-your-ugly" },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary CTA label", "default": "Take the Quiz" },
    { "type": "image_picker", "id": "featured_media", "label": "Hero image" }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Glow-in-the-dark LED strand" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "UglyGlow Hero",
      "blocks": [
        { "type": "bullet", "settings": { "text": "Limited run: 500 knit drops" } },
        { "type": "bullet", "settings": { "text": "Ships free over $75" } },
        { "type": "bullet", "settings": { "text": "Klaviyo VIP earns Golden Bell perks" } }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.uglyglow-hero {
  position: relative;
  padding: clamp(4rem, 8vw, 8rem) 0;
  background: radial-gradient(circle at top left, rgba(0,209,178,0.18), rgba(26,26,26,0.95)), #1A1A1A;
  color: #F5F7FA;
}
.uglyglow-hero__inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 3rem;
  align-items: center;
}
.uglyglow-hero__title {
  font-family: 'Bangers', cursive;
  font-size: clamp(3rem, 5vw, 4.8rem);
  color: #FFD700;
  text-shadow: 0 0 25px rgba(255, 215, 0, 0.6);
}
.uglyglow-hero__subtitle {
  font-family: 'Lora', serif;
  font-style: italic;
  font-size: 1.4rem;
  color: #00D1B2;
  margin-bottom: 2rem;
}
.uglyglow-hero__cta .button--ghost {
  border: 2px solid #00D1B2;
  color: #00D1B2;
}
.uglyglow-hero__cta .button--ghost:hover {
  background: rgba(0,209,178,0.15);
}
.uglyglow-hero__bullets {
  list-style: none;
  padding: 0;
  margin: 2.5rem 0 0;
  display: grid;
  gap: 0.75rem;
}
.uglyglow-hero__bullets li {
  display: flex;
  gap: 0.75rem;
  align-items: center;
  font-family: 'Lora', serif;
  color: #F5F7FA;
  background: rgba(255, 46, 87, 0.15);
  border-radius: 999px;
  padding: 0.65rem 1.25rem;
}
.hero-media {
  border-radius: 30px;
  box-shadow: 0 40px 120px rgba(0,0,0,0.35);
  border: 4px solid rgba(255, 215, 0, 0.4);
}
.hero-badge {
  position: absolute;
  bottom: 12%;
  right: 8%;
  background: linear-gradient(135deg, rgba(255,46,87,0.95), rgba(255,215,0,0.95));
  color: #1A1A1A;
  padding: 1.4rem 2rem;
  border-radius: 24px;
  text-align: left;
  box-shadow: 0 20px 60px rgba(255, 46, 87, 0.4);
}
.hero-badge__label {
  display: block;
  font-family: 'Bangers', cursive;
  font-size: 1.4rem;
}
.hero-badge__detail {
  font-family: 'Lora', serif;
  font-size: 1rem;
}
@media (max-width: 740px) {
  .hero-badge { position: relative; top: 1.5rem; right: auto; }
}
{% endstylesheet %}
